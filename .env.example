# RoadSense Einstellungen
# Diese Datei kopieren und die Kopie ".env" nennen (ohne .example), dann die Werte eintragen.
# Die Datei .env niemals weitergeben oder auf GitHub hochladen (.gitignore schließt sie aus).

# Claude-API-Schlüssel von console.anthropic.com (beginnt mit sk-ant-).
# Ohne Schlüssel läuft die App im Offline-Modus: Bewertung nach Regeln, Fotoauswertung funktioniert trotzdem.
ANTHROPIC_API_KEY=

# Zapier "Catch Hook"-Adresse für Google Sheets (optional).
ZAPIER_WEBHOOK_URL=

# Modell (normalerweise nicht ändern).
CLAUDE_MODEL=claude-sonnet-5-5

# --- Render + Auswerte-Laptop (siehe LIES_MICH_ZUERST.txt) -----------------------------
# Auf RENDER eintragen (Dashboard -> Environment), nicht auf dem Laptop:
#   AUSWERTUNG_URL   = feste Adresse des Laptops, z. B. https://laptop-name.tail1234.ts.net
#   AUSWERTUNG_TOKEN = derselbe Schlüssel wie auf dem Laptop
# Auf dem LAPTOP erzeugt Auswerte_Laptop_starten.bat den Schlüssel automatisch in dieser Datei:
#   AUSWERTUNG_TOKEN=...
